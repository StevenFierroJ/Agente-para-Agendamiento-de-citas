# LLM (Gemini por su punto de acceso compatible con OpenAI)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000
LLM_MAX_ITERACIONES=5
# Precio por millón de tokens, en USD (consultar la página de precios vigente)
LLM_PRECIO_ENTRADA_1M=
LLM_PRECIO_SALIDA_1M=

# RAG
RAG_UMBRAL=

# Bases de datos (coinciden con docker-compose.yml)
DATABASE_URL=postgres://agenda:agenda@localhost:5432/agenda
MONGO_URL=mongodb://localhost:27017/agenda

# Seed: primer día de la agenda (YYYY-MM-DD, hora de Colombia). Vacío = hoy.
SEED_DESDE=
