# LLM: Claude Haiku 4.5 por la API de Anthropic (SDK @anthropic-ai/sdk)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_TIMEOUT_MS=20000
LLM_MAX_ITERACIONES=5
LLM_MAX_TOKENS=1024
# Precio por millón de tokens, USD. Claude Haiku 4.5, consultado el 2026-10-03 en
# https://platform.claude.com/docs/en/about-claude/pricing (entrada $1, salida $5).
# Vacío = costo desconocido (se reporta como null, no como 0).
LLM_PRECIO_ENTRADA_1M=1
LLM_PRECIO_SALIDA_1M=5

# RAG
# Similitud mínima de un fragmento (multilingual-e5-small), calibrada con harness/rag (D-25).
RAG_UMBRAL=0.837

# Bases de datos (coinciden con docker-compose.yml)
DATABASE_URL=postgres://agenda:agenda@localhost:5432/agenda
MONGO_URL=mongodb://localhost:27017/agenda

# Seed: primer día de la agenda (YYYY-MM-DD, hora de Colombia). Vacío = hoy.
SEED_DESDE=
