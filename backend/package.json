{
  "name": "wekall-agendamiento-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrar": "tsx --env-file-if-exists=../.env src/infraestructura/postgres/migrar.ts",
